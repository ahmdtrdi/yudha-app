{
  "openapi": "3.1.0",
  "info": {
    "title": "YUDHA Public API",
    "version": "1.0.0",
    "description": "PRD-aligned public contract. x-delivery-gate identifies the acceptance gate that activates conformance enforcement."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/register": { "post": { "security": [], "x-delivery-gate": 1, "requestBody": { "$ref": "#/components/requestBodies/Register" }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/auth/login": { "post": { "security": [], "x-delivery-gate": 1, "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/lobby/summary": { "get": { "x-delivery-gate": 1, "responses": { "200": { "description": "Lobby summary", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/LobbySummary" } } } } } }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/profile": {
      "get": { "x-delivery-gate": 1, "responses": { "200": { "description": "Profile", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Profile" } } } } } }, "401": { "$ref": "#/components/responses/Error" } } },
      "patch": { "x-delivery-gate": 1, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/profile/loadout": { "patch": { "x-delivery-gate": 1, "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "characterId": { "type": "string" }, "towerId": { "type": "string" } }, "minProperties": 1, "additionalProperties": false } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/notifications/preferences": {
      "get": { "responses": { "200": { "description": "Notification preferences", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/NotificationPreferences" } } } } } } } },
      "patch": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferencesUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/notifications/installations/{installationId}": {
      "parameters": [{ "in": "path", "name": "installationId", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "put": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushInstallationUpsert" } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } },
      "delete": { "responses": { "200": { "$ref": "#/components/responses/Data" } } }
    },
    "/notifications/deliveries/{deliveryId}/open": {
      "post": { "parameters": [{ "in": "path", "name": "deliveryId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "$ref": "#/components/responses/Data" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/practice/dashboard": { "get": { "x-delivery-gate": 1, "responses": { "200": { "$ref": "#/components/responses/Data" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/practice/sessions": { "post": { "x-delivery-gate": 1, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePracticeSession" } } } }, "responses": { "201": { "$ref": "#/components/responses/Data" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/practice/sessions/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "x-delivery-gate": 1, "responses": { "200": { "$ref": "#/components/responses/Data" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/practice/sessions/{id}/answers": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 1, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PracticeAnswerRequest" } } } }, "responses": { "200": { "description": "Committed or replayed answer", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PracticeAnswerResult" } } } } } }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/practice/sessions/{id}/finish": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 1, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdempotentRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/practice/history": { "get": { "x-delivery-gate": 1, "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" }, { "in": "query", "name": "category", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Page" } } } },
    "/analytics": { "get": { "x-delivery-gate": 1, "responses": { "200": { "description": "Learning analytics", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Analytics" } } } } } } } } },
    "/leaderboard": { "get": { "security": [], "x-delivery-gate": 1, "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" }], "responses": { "200": { "description": "Ranked leaderboard page", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/LeaderboardPage" } } } } } } } } },
    "/leaderboard/me": { "get": { "x-delivery-gate": 1, "responses": { "200": { "description": "Authenticated leaderboard rank", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/LeaderboardEntry" } } } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/store/items": { "get": { "x-delivery-gate": 3, "parameters": [{ "in": "query", "name": "type", "schema": { "enum": ["character", "tower"] } }], "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/store/beta-credits": { "post": { "x-delivery-gate": 3, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/store/purchases": { "post": { "x-delivery-gate": 3, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/hired-pass": { "get": { "x-delivery-gate": 3, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/hired-pass/beta-activate": { "post": { "x-delivery-gate": 3, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/hired-pass/rewards/{rewardId}/claim": { "parameters": [{ "in": "path", "name": "rewardId", "required": true, "schema": { "type": "string" } }], "post": { "x-delivery-gate": 3, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/interview/sessions": {
      "get": { "x-delivery-gate": 4, "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" }], "responses": { "200": { "$ref": "#/components/responses/Page" } } },
      "post": { "x-delivery-gate": 4, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "201": { "$ref": "#/components/responses/Data" } } }
    },
    "/interview/sessions/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "x-delivery-gate": 4, "responses": { "200": { "$ref": "#/components/responses/Data" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/interview/sessions/{id}/turns": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 4, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/interview/sessions/{id}/turns/stream": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 4, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } } } } },
    "/interview/sessions/{id}/complete": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 4, "requestBody": { "$ref": "#/components/requestBodies/Idempotent" }, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/interview/sessions/{id}/speech/transcriptions": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "x-delivery-gate": 4, "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["audio"], "properties": { "audio": { "type": "string", "contentEncoding": "binary" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Data" } } } },
    "/interview/sessions/{id}/speech/questions/{turnId}/audio": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "in": "path", "name": "turnId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "x-delivery-gate": 4, "responses": { "200": { "description": "Audio stream", "content": { "audio/*": { "schema": { "type": "string", "contentEncoding": "binary" } } } } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Id": { "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Limit": { "in": "query", "name": "limit", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Offset": { "in": "query", "name": "offset", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
    },
    "requestBodies": {
      "Idempotent": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdempotentRequest" } } } },
      "Register": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password", "username", "target"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 8 }, "username": { "type": "string", "minLength": 1 }, "target": { "$ref": "#/components/schemas/Target" }, "fullName": { "type": ["string", "null"] } }, "additionalProperties": false } } } },
      "Login": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" } }, "additionalProperties": false } } } }
    },
    "responses": {
      "Data": { "description": "Successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataEnvelope" } } } },
      "Page": { "description": "Paginated response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
      "Error": { "description": "Canonical error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "Target": { "type": "string", "enum": ["cpns", "bumn"] },
      "Tier": { "type": "string", "enum": ["rookie", "warrior", "elite", "legend"] },
      "IdempotencyKey": { "type": "string", "minLength": 1, "maxLength": 160 },
      "IdempotentRequest": { "type": "object", "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/components/schemas/IdempotencyKey" } } },
      "DataEnvelope": { "type": "object", "required": ["data"], "properties": { "data": {} } },
      "PageEnvelope": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["items", "limit", "offset", "total"], "properties": { "items": { "type": "array", "items": {} }, "limit": { "type": "integer" }, "offset": { "type": "integer" }, "total": { "type": "integer" } } } } },
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "details", "requestId"], "properties": { "code": { "type": "string", "enum": ["AUTH_REQUIRED", "FORBIDDEN", "VALIDATION_FAILED", "NOT_FOUND", "CONFLICT", "IDEMPOTENCY_KEY_REUSED", "INSUFFICIENT_Y_COIN", "FEATURE_DISABLED", "ENTITLEMENT_REQUIRED", "QUEUE_UNAVAILABLE", "ROOM_CODE_INVALID", "ACTION_REJECTED", "PROVIDER_UNAVAILABLE", "RATE_LIMITED", "INTERNAL_ERROR"] }, "message": { "type": "string" }, "details": { "type": "object" }, "requestId": { "type": "string" } } } } },
      "Streak": { "type": "object", "required": ["current", "best", "lastDate"], "properties": { "current": { "type": "integer", "minimum": 0 }, "best": { "type": "integer", "minimum": 0 }, "lastDate": { "type": ["string", "null"], "format": "date" } } },
      "RankedStats": { "type": "object", "required": ["wins", "losses", "draws", "winRate"], "properties": { "wins": { "type": "integer" }, "losses": { "type": "integer" }, "draws": { "type": "integer" }, "winRate": { "type": "number" } } },
      "Profile": { "type": "object", "required": ["id", "username", "target", "rankPoints", "tier", "rankedStats", "yCoins", "characterId", "towerId", "streak"], "properties": { "id": { "type": "string", "format": "uuid" }, "username": { "type": "string" }, "fullName": { "type": ["string", "null"] }, "target": { "$ref": "#/components/schemas/Target" }, "rankPoints": { "type": "integer" }, "tier": { "$ref": "#/components/schemas/Tier" }, "rankedStats": { "$ref": "#/components/schemas/RankedStats" }, "yCoins": { "type": "integer" }, "characterId": { "type": ["string", "null"] }, "towerId": { "type": ["string", "null"] }, "streak": { "$ref": "#/components/schemas/Streak" } } },
      "ProfileUpdate": { "type": "object", "minProperties": 1, "properties": { "username": { "type": "string", "minLength": 1 }, "fullName": { "type": ["string", "null"] }, "target": { "$ref": "#/components/schemas/Target" } }, "additionalProperties": false },
      "DailyMission": { "type": "object", "required": ["key", "title", "target", "rewardRankPoints", "businessDate", "progress", "completed", "completedAt"], "properties": { "key": { "enum": ["daily_practice", "daily_pvp"] }, "title": { "type": "string" }, "target": { "type": "integer", "const": 1 }, "rewardRankPoints": { "type": "integer" }, "businessDate": { "type": "string", "format": "date" }, "progress": { "type": "integer", "minimum": 0, "maximum": 1 }, "completed": { "type": "boolean" }, "completedAt": { "type": ["string", "null"], "format": "date-time" } } },
      "NotificationPreferences": { "type": "object", "required": ["enabled", "morningEnabled", "morningTime", "rescueEnabled", "rescueTime"], "properties": { "enabled": { "type": "boolean" }, "morningEnabled": { "type": "boolean" }, "morningTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }, "rescueEnabled": { "type": "boolean" }, "rescueTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" } }, "additionalProperties": false },
      "NotificationPreferencesUpdate": { "type": "object", "minProperties": 1, "properties": { "enabled": { "type": "boolean" }, "morningEnabled": { "type": "boolean" }, "morningTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }, "rescueEnabled": { "type": "boolean" }, "rescueTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" } }, "additionalProperties": false },
      "PushInstallationUpsert": { "type": "object", "required": ["token", "platform", "timeZone"], "properties": { "token": { "type": "string", "minLength": 20, "maxLength": 4096 }, "platform": { "enum": ["android", "web"] }, "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 } }, "additionalProperties": false },
      "PracticeRecommendation": { "type": "object", "required": ["type", "target", "reason", "metrics"], "properties": { "type": { "const": "practice" }, "target": { "$ref": "#/components/schemas/Target" }, "category": { "type": "string" }, "subcategory": { "type": "string" }, "reason": { "type": "string" }, "metrics": { "$ref": "#/components/schemas/RecommendationMetrics" } } },
      "InterviewRecommendation": { "type": "object", "required": ["type", "reason", "lastCompletedAt"], "properties": { "type": { "const": "interview" }, "reason": { "type": "string" }, "lastCompletedAt": { "type": ["string", "null"], "format": "date-time" } } },
      "RecommendationMetrics": { "type": "object", "properties": { "sampleSize": { "type": "integer" }, "accuracy": { "type": ["number", "null"] }, "lastPracticedAt": { "type": ["string", "null"], "format": "date-time" }, "lastInterviewCompletedAt": { "type": ["string", "null"], "format": "date-time" } } },
      "Recommendation": { "oneOf": [{ "$ref": "#/components/schemas/PracticeRecommendation" }, { "$ref": "#/components/schemas/InterviewRecommendation" }], "discriminator": { "propertyName": "type" } },
      "LobbySummary": { "type": "object", "required": ["profile", "tier", "rankPoints", "yCoins", "dailyMissions", "streak", "hiredPassSummary", "recommendation"], "properties": { "profile": { "$ref": "#/components/schemas/Profile" }, "tier": { "$ref": "#/components/schemas/Tier" }, "rankPoints": { "type": "integer" }, "yCoins": { "type": "integer" }, "dailyMissions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/components/schemas/DailyMission" } }, "streak": { "$ref": "#/components/schemas/Streak" }, "hiredPassSummary": { "type": ["object", "null"] }, "recommendation": { "$ref": "#/components/schemas/Recommendation" } } },
      "CreatePracticeSession": { "type": "object", "properties": { "category": { "type": "string" }, "subcategory": { "type": "string" } }, "dependentRequired": { "subcategory": ["category"] }, "additionalProperties": false },
      "PracticeQuestion": { "type": "object", "required": ["sessionQuestionId", "questionId", "questionOrder", "target", "category", "prompt", "options", "difficulty", "weight", "effect", "timeLimitSeconds"], "properties": { "sessionQuestionId": { "type": "string", "format": "uuid" }, "questionId": { "type": "string", "format": "uuid" }, "questionOrder": { "type": "integer", "minimum": 1, "maximum": 5 }, "target": { "$ref": "#/components/schemas/Target" }, "category": { "type": "string" }, "subcategory": { "type": ["string", "null"] }, "prompt": { "type": "string" }, "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } }, "difficulty": { "enum": ["easy", "medium", "hard"] }, "weight": { "type": "integer", "minimum": 1, "maximum": 4 }, "effect": { "enum": ["damage", "heal"] }, "timeLimitSeconds": { "type": "integer" }, "hint": { "type": ["string", "null"] } }, "not": { "anyOf": [{ "required": ["correctOptionIndex"] }, { "required": ["explanation"] }] } },
      "PracticeAnswerRequest": { "type": "object", "required": ["idempotencyKey", "sessionQuestionId", "selectedOptionIndex", "usedHint"], "properties": { "idempotencyKey": { "$ref": "#/components/schemas/IdempotencyKey" }, "sessionQuestionId": { "type": "string", "format": "uuid" }, "selectedOptionIndex": { "type": "integer", "minimum": 0, "maximum": 5 }, "responseTimeMs": { "type": "integer", "minimum": 0 }, "usedHint": { "type": "boolean" } }, "additionalProperties": false },
      "PracticeAnswerResult": { "type": "object", "required": ["isCorrect", "correctOptionIndex", "explanation", "scoreGained", "progress"], "properties": { "isCorrect": { "type": "boolean" }, "correctOptionIndex": { "type": "integer" }, "explanation": { "type": "string" }, "scoreGained": { "type": "integer" }, "progress": { "type": "object" } } },
      "Analytics": { "type": "object", "required": ["window", "practice", "ranked", "weakTopics", "publicMatches", "tier", "streak", "history", "recommendation"], "properties": { "window": { "type": "object" }, "practice": { "type": "object" }, "ranked": { "type": "object" }, "weakTopics": { "type": "array", "items": { "type": "object" } }, "publicMatches": { "type": "object" }, "tier": { "$ref": "#/components/schemas/Tier" }, "streak": { "$ref": "#/components/schemas/Streak" }, "history": { "type": "object" }, "recommendation": { "$ref": "#/components/schemas/Recommendation" } } },
      "LeaderboardEntry": { "type": "object", "required": ["rank", "userId", "username", "rankPoints", "tier", "rankedWins", "rankedWinRate"], "properties": { "rank": { "type": "integer", "minimum": 1 }, "userId": { "type": "string", "format": "uuid" }, "username": { "type": ["string", "null"] }, "rankPoints": { "type": "integer", "minimum": 0 }, "tier": { "$ref": "#/components/schemas/Tier" }, "rankedWins": { "type": "integer", "minimum": 0 }, "rankedWinRate": { "type": "number", "minimum": 0, "maximum": 100 } } },
      "LeaderboardPage": { "type": "object", "required": ["items", "limit", "offset", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/LeaderboardEntry" } }, "limit": { "type": "integer", "minimum": 1 }, "offset": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } }
    }
  }
}
