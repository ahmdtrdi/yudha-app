{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yudha.local/contracts/store-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "betaMode", "betaPackages", "disabledPaidPackages", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "betaMode": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "rarity", "coinPrice", "active", "proExclusive"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["character", "tower", "arena"] },
          "rarity": { "enum": ["common", "rare", "epic", "legendary"] },
          "coinPrice": { "type": "integer", "minimum": 0 },
          "active": { "type": "boolean" },
          "proExclusive": { "type": "boolean" }
        }
      }
    }
  }
}
