{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yudha.local/contracts/question-bank.schema.json",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "approvalStatus", "smeApproved", "approverReference", "target", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "enum": ["cpns", "bumn"] },
    "approvalStatus": { "enum": ["development", "sme_approved"] },
    "smeApproved": { "type": "boolean" },
    "approverReference": { "type": ["string", "null"] },
    "questions": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": ["sourceKey", "revision", "target", "category", "subcategory", "primarySkillId", "prerequisiteSkillIds", "prompt", "options", "correctOptionIndex", "explanation", "difficulty", "questionType", "expectedTimeMs", "standardTimeLimitMs", "curriculumWeight", "assessmentEligible", "qualityState", "smeApproved", "approvedAt", "approverReference", "weight", "effect", "timeLimitSeconds", "active"],
        "properties": {
          "sourceKey": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "target": { "enum": ["cpns", "bumn"] },
          "category": { "type": "string", "minLength": 1 },
          "subcategory": { "type": ["string", "null"] },
          "primarySkillId": { "type": "string", "minLength": 1 },
          "prerequisiteSkillIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
          "correctOptionIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
          "explanation": { "type": "string", "minLength": 1 },
          "questionType": { "const": "multiple_choice" },
          "expectedTimeMs": { "type": ["integer", "null"], "minimum": 1 },
          "standardTimeLimitMs": { "type": "integer", "minimum": 1 },
          "curriculumWeight": { "type": "number", "exclusiveMinimum": 0 },
          "assessmentEligible": { "type": "boolean" },
          "qualityState": { "enum": ["development", "approved", "under_review", "invalidated", "disabled"] },
          "smeApproved": { "type": "boolean" },
          "approvedAt": { "type": ["string", "null"], "format": "date-time" },
          "approverReference": { "type": ["string", "null"] },
          "weight": { "type": "integer", "minimum": 1, "maximum": 4 },
          "effect": { "enum": ["damage", "heal"] },
          "damageValue": { "type": "integer", "minimum": 0 },
          "healValue": { "type": "integer", "minimum": 0 },
          "timeLimitSeconds": { "type": "integer", "minimum": 1 },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
