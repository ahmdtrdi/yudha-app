{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yudha.local/contracts/season-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "manifestVersion", "releaseActive", "season", "missions", "rewards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestVersion": { "type": "string", "minLength": 1 },
    "releaseActive": { "type": "boolean" },
    "missions": { "type": "array", "minItems": 1 },
    "rewards": { "type": "array", "minItems": 2 }
  }
}
