# --- APP SETTINGS ---
# Use 3000 for backend-api, and maybe 3001 for backend-game to avoid conflicts
PORT=3001

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
# Legacy name still supported as a fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# --- UPSTASH REDIS (native TLS protocol) ---
# Use the rediss:// connection string from the Upstash Connect dialog.
# backend-game intentionally does not use the Upstash REST URL/token.
REDIS_URL=
REDIS_KEY_PREFIX=yudha:game:development
# Optional. Leave blank to generate a unique ID from hostname/process data.
GAME_INSTANCE_ID=
