# --- APP SETTINGS ---
# Use 3000 for backend-api, and maybe 3001 for backend-game to avoid conflicts
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:8080

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy name still supported as a fallback:
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Non-production only. Enables POST /store/beta-credits (+100 Y-Coin).
ENABLE_BETA_ECONOMY_CREDIT=false
# Non-production harness only. Never enable this in production.
ENABLE_INTERVIEW_DEV_TOKENS=false

# --- DAILY REMINDER NOTIFICATIONS (Firebase Cloud Messaging) ---
# Leave false for local development unless Firebase service credentials are set.
NOTIFICATIONS_ENABLED=false
APP_PUBLIC_URL=https://your-yudha-app.example
FIREBASE_PROJECT_ID=yudha-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Keep the escaped newlines when configuring this as a deployment secret.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI LLM PROVIDERS (gemini | groq) ---
INTERVIEW_LLM_PROVIDER=gemini

# Gemini Flash Settings (Free Tier Friendly)
# Get your key at https://aistudio.google.com/apikey (new keys start with AQ.)
GEMINI_API_KEY=your_gemini_api_key_here
INTERVIEW_GEMINI_MODEL=gemini-3.5-flash
INTERVIEW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Comma-separated fallback models if primary model fails (optional)
INTERVIEW_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
INTERVIEW_GEMINI_TIMEOUT_MS=20000
INTERVIEW_GEMINI_MAX_OUTPUT_TOKENS=2048
INTERVIEW_GEMINI_MAX_RETRIES=3

# Groq LLM Settings (Fallback/Alternative)
GROQ_API_KEY=your_groq_api_key_here
INTERVIEW_LLM_BASE_URL=https://api.groq.com/openai/v1
INTERVIEW_LLM_MODEL=openai/gpt-oss-120b
INTERVIEW_LLM_TIMEOUT_MS=15000
INTERVIEW_LLM_MAX_OUTPUT_TOKENS=2048
INTERVIEW_LLM_MAX_RETRIES=1
INTERVIEW_LLM_REASONING_EFFORT=low

INTERVIEW_PROMPT_VERSION=interview-v1
INTERVIEW_MAX_TURNS=5
INTERVIEW_RESPONSE_LANGUAGE=id
INTERVIEW_AUDIO_MAX_BYTES=10485760
# Explicit rollout flag. Enable only after Groq STT and ElevenLabs are configured.
INTERVIEW_LIVE_SPEECH_ENABLED=false
INTERVIEW_LIVE_MAX_CHUNK_BYTES=65536
INTERVIEW_LIVE_MAX_ANSWER_SECONDS=90
INTERVIEW_LIVE_INACTIVITY_TIMEOUT_MS=15000

# --- SPEECH STT (Groq Whisper) ---
INTERVIEW_STT_BASE_URL=https://api.groq.com/openai/v1
INTERVIEW_STT_MODEL=whisper-large-v3-turbo
INTERVIEW_STT_TIMEOUT_MS=15000
# Optional. Defaults to GROQ_API_KEY when omitted.
# INTERVIEW_STT_API_KEY=your_groq_or_other_stt_api_key_here

# --- SPEECH TTS PROVIDERS (groq | elevenlabs) ---
INTERVIEW_TTS_PROVIDER=elevenlabs

# Groq TTS (Orpheus - Free Tier) Settings
INTERVIEW_GROQ_TTS_BASE_URL=https://api.groq.com/openai/v1
INTERVIEW_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
INTERVIEW_GROQ_TTS_VOICE=autumn
INTERVIEW_GROQ_TTS_TIMEOUT_MS=15000

# ElevenLabs Settings (Modular Alternative)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
INTERVIEW_TTS_BASE_URL=https://api.elevenlabs.io/v1
INTERVIEW_TTS_VOICE_ID=your_elevenlabs_voice_id_here
INTERVIEW_TTS_MODEL_ID=eleven_flash_v2_5
INTERVIEW_TTS_OUTPUT_FORMAT=mp3_44100_128
INTERVIEW_TTS_TIMEOUT_MS=15000

INTERVIEW_CONTEXT_MAX_ITEMS=5
INTERVIEW_CONTEXT_MAX_CHARS=6000
